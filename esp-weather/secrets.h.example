// Template: copy to secrets.h (in this sketch folder) and fill in your
// values. secrets.h is gitignored - never commit real credentials.
#ifndef SECRETS_H
#define SECRETS_H

// Station marker: the indoor sketch refuses to compile without it, so the
// outdoor station's secrets.h can't be used here by mistake
#define SECRETS_STATION_INDOOR

const char* WIFI_SSID = "";
const char* WIFI_PASSWORD = "";
const char* PG_USER = "esp32_1";  // indoor station's database role (writes both tables)
const char* PG_PASSWORD = "";
const char* PG_DBNAME = "weather";
const IPAddress PG_IP(0, 0, 0, 0);

// Outdoor station's WiFi MAC, printed at its boot as "MAC address: ..."
// (also shown as "MAC:" in the Arduino IDE upload log)
const uint8_t OUTDOOR_MAC[6] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00};

// ESP-NOW encryption keys: identical in both stations' secrets.h, 16 random
// bytes each, e.g.
//   python3 -c "import os; print(', '.join(f'0x{b:02x}' for b in os.urandom(16)))"
const uint8_t ESPNOW_PMK[16] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
                                0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
const uint8_t ESPNOW_LMK[16] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
                                0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};

#endif
